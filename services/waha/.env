# WAHA secrets - keep private.
# WAHA_API_KEY_PLAIN is what clients send in the X-Api-Key header.
# WAHA_API_KEY_SHA512 must remain the sha512 of the plain key.
WAHA_API_KEY_PLAIN=
WAHA_API_KEY_SHA512=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

# whatsapp-sync database roles. Provision with
# whatsapp-sync/deploy/provision-whatsapp-db.sql before first boot.
WHATSAPP_INGEST_PASSWORD=
WHATSAPP_MCP_PASSWORD=
